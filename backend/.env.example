# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lslp
DB_USER=postgres
DB_PASSWORD=

# Firebase project ID (backend — used for JWT verification via public JWKS endpoint, no service account needed)
FIREBASE_PROJECT_ID=

# Firebase Web SDK (frontend — copy to frontend/.env.local as VITE_* keys)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
